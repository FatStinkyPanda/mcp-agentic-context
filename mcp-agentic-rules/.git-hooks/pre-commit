#!/bin/bash
# MCP Pre-commit Hook — the per-commit E2E gate.
# Runs the collab E2E + write-discipline tests (engine selftest inside, fully
# isolated store). NEVER mutates the working tree: a hook that rewrites files
# under 100 concurrent agents is a correctness hazard, so the old auto-fix
# steps are gone by design (run `mcp fix . --safe` yourself when you want it).
set -e

echo "[MCP] pre-commit: collab E2E gate..."
if [ -f "./.venv/Scripts/python" ]; then
    PYTHON_CMD="./.venv/Scripts/python"
elif [ -f "./.venv/bin/python" ]; then
    PYTHON_CMD="./.venv/bin/python"
else
    PYTHON_CMD="python"
fi

export MCP_NSYNC_AUTOSYNC=0
$PYTHON_CMD -m pytest \
    mcp-agentic-rules/tests/test_collab_e2e.py \
    mcp-agentic-rules/tests/test_write_discipline.py \
    -q -m "not swarm and not soak"
echo "[MCP] pre-commit gate green."
