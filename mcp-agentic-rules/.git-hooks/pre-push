#!/bin/bash
# MCP Pre-push Hook — the full verification gate: engine selftest (isolated
# store), the complete test suite (minus the nightly soak), a real
# multi-process swarm, and the security audit. Worktree seats share this hook
# automatically (.git/hooks is common to all worktrees).
set -e

echo "[MCP] pre-push: full E2E + swarm + security gate..."
if [ -f "./.venv/Scripts/python" ]; then
    PYTHON_CMD="./.venv/Scripts/python"
elif [ -f "./.venv/bin/python" ]; then
    PYTHON_CMD="./.venv/bin/python"
else
    PYTHON_CMD="python"
fi

export MCP_NSYNC_AUTOSYNC=0
$PYTHON_CMD mcp-agentic-rules/scripts/agent_collab.py selftest
# Run the heavy suite (ML/vector tests load torch+models) and the
# subprocess-spawning swarm tests in SEPARATE processes: bundling them lets
# the swarm subprocesses stack on top of the parent's accumulated ML imports
# and exhaust RAM on memory-constrained machines. Two invocations keep full
# coverage while each runs in a fresh, bounded-memory process (mirrors CI).
$PYTHON_CMD -m pytest mcp-agentic-rules/tests -q -m "not soak and not swarm"
$PYTHON_CMD -m pytest mcp-agentic-rules/tests -q -m "swarm"
$PYTHON_CMD mcp-agentic-rules/scripts/collab_swarm.py run --agents 6 --iters 12
$PYTHON_CMD mcp-agentic-rules/mcp.py security .

# Git LFS — only when this repo actually uses LFS
if [ -f .gitattributes ] && grep -q "filter=lfs" .gitattributes 2>/dev/null; then
    command -v git-lfs >/dev/null 2>&1 || { echo >&2 "git-lfs is required by .gitattributes but was not found on PATH"; exit 2; }
    git lfs pre-push "$@"
fi
echo "[MCP] pre-push gate green."
